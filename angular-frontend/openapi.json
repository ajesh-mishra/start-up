    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": { "description": "Successful Response", "content": { "application/json": { "schema": {} } } }
        }
      }
    },
    "/items/{item_id}": {
      "get": {
        "summary": "Read Item",
        "operationId": "read_item_items__item_id__get",
        "parameters": [
          { "name": "item_id", "in": "path", "required": true, "schema": { "type": "integer", "title": "Item Id" } },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Q" }
          }
        ],
        "responses": {
          "200": { "description": "Successful Response", "content": { "application/json": { "schema": {} } } },
          "422": {
            "description": "Validation Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HTTPValidationError" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": { "items": { "$ref": "#/components/schemas/ValidationError" }, "type": "array", "title": "Detail" }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Product": {
        "properties": {
          "name": { "type": "string", "maxLength": 100, "minLength": 1, "title": "Name" },
          "category": { "type": "string", "maxLength": 100, "minLength": 1, "title": "Category" },
          "price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Price",
            "description": "Unit price in minor currency units"
          },
          "id": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Id" }
        },
        "type": "object",
        "required": ["name", "category", "price"],
        "title": "Product"
      },
      "ProductCreate": {
        "properties": {
          "name": { "type": "string", "maxLength": 100, "minLength": 1, "title": "Name" },
          "category": { "type": "string", "maxLength": 100, "minLength": 1, "title": "Category" },
          "price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Price",
            "description": "Unit price in minor currency units"
          }
        },
        "type": "object",
        "required": ["name", "category", "price"],
        "title": "ProductCreate"
      },
      "ProductUpdate": {
        "properties": {
          "name": {
            "anyOf": [{ "type": "string", "maxLength": 100, "minLength": 1 }, { "type": "null" }],
            "title": "Name"
          },
          "category": {
            "anyOf": [{ "type": "string", "maxLength": 100, "minLength": 1 }, { "type": "null" }],
            "title": "Category"
          },
          "price": {
            "anyOf": [{ "type": "integer", "minimum": 0.0 }, { "type": "null" }],
            "title": "Price",
            "description": "Unit price in minor currency units"
          }
        },
        "type": "object",
        "title": "ProductUpdate"
      },
      "Purchase": {
        "properties": {
          "purchase_date": { "type": "string", "format": "date", "title": "Purchase Date" },
          "product_id": { "type": "integer", "exclusiveMinimum": 0.0, "title": "Product Id" },
          "quantity": { "type": "integer", "exclusiveMinimum": 0.0, "title": "Quantity" },
          "price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Price",
            "description": "Unit price in minor currency units"
          },
          "id": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Id" }
        },
        "type": "object",
        "required": ["purchase_date", "product_id", "quantity", "price"],
        "title": "Purchase"
      },
      "PurchaseCreate": {
        "properties": {
          "purchase_date": { "type": "string", "format": "date", "title": "Purchase Date" },
          "product_id": { "type": "integer", "exclusiveMinimum": 0.0, "title": "Product Id" },
          "quantity": { "type": "integer", "exclusiveMinimum": 0.0, "title": "Quantity" },
          "price": {
            "anyOf": [{ "type": "integer", "minimum": 0.0 }, { "type": "null" }],
            "title": "Price",
            "description": "Unit price in minor currency units"
          }
        },
        "type": "object",
        "required": ["purchase_date", "product_id", "quantity"],
        "title": "PurchaseCreate"
      },
      "PurchaseUpdate": {
        "properties": {
          "purchase_date": {
            "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }],
            "title": "Purchase Date"
          },
          "product_id": {
            "anyOf": [{ "type": "integer", "exclusiveMinimum": 0.0 }, { "type": "null" }],
            "title": "Product Id"
          },
          "quantity": {
            "anyOf": [{ "type": "integer", "exclusiveMinimum": 0.0 }, { "type": "null" }],
            "title": "Quantity"
          }
        },
        "type": "object",
        "title": "PurchaseUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" },
          "input": { "title": "Input" },
          "ctx": { "type": "object", "title": "Context" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
