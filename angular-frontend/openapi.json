{
  "openapi": "3.1.0",
  "info": { "title": "FastAPI", "version": "0.1.0" },
  "paths": {
    "/purchase/": {
      "get": {
        "tags": ["purchase"],
        "summary": "Get Purchase",
        "operationId": "get_purchase_purchase__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": { "$ref": "#/components/schemas/Purchase" },
                  "type": "array",
                  "title": "Response Get Purchase Purchase  Get"
                }
              }
            }
          }
        }
      }
    },
    "/purchase/daily-expense": {
      "get": {
        "tags": ["purchase"],
        "summary": "Get Purchase By Date",
        "operationId": "get_purchase_by_date_purchase_daily_expense_get",
        "parameters": [
          {
            "name": "purchase_date",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date", "title": "Purchase Date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Purchase" },
                  "title": "Response Get Purchase By Date Purchase Daily Expense Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HTTPValidationError" } } }
          }
        }
      }
    },
    "/purchase/monthly-expense": {
      "get": {
        "tags": ["purchase"],
        "summary": "Get Purchase By Month",
        "operationId": "get_purchase_by_month_purchase_monthly_expense_get",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "maximum": 2100, "minimum": 2000, "examples": [2026], "title": "Year" }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "maximum": 12, "minimum": 1, "examples": [3], "title": "Month" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Purchase" },
                  "title": "Response Get Purchase By Month Purchase Monthly Expense Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HTTPValidationError" } } }
          }
        }
      }
    },
    "/purchase/total-monthly-expense": {
      "get": {
        "tags": ["purchase"],
        "summary": "Get Total Purchase By Month",
        "operationId": "get_total_purchase_by_month_purchase_total_monthly_expense_get",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "maximum": 2100, "minimum": 2000, "examples": [2026], "title": "Year" }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "maximum": 12, "minimum": 1, "examples": [3], "title": "Month" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
                  "title": "Response Get Total Purchase By Month Purchase Total Monthly Expense Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HTTPValidationError" } } }
          }
        }
      }
    },
    "/purchase/total-yearly-expense": {
      "get": {
        "tags": ["purchase"],
        "summary": "Get Total Purchase By Year",
        "operationId": "get_total_purchase_by_year_purchase_total_yearly_expense_get",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "maximum": 2100, "minimum": 2000, "examples": [2026], "title": "Year" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "object", "additionalProperties": { "type": "integer" } },
                  "title": "Response Get Total Purchase By Year Purchase Total Yearly Expense Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HTTPValidationError" } } }
          }
        }
      }
    },
    "/purchase": {
      "post": {
        "tags": ["purchase"],
        "summary": "Create Purchase",
        "operationId": "create_purchase_purchase_post",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PurchaseCreate" } } },
